service vendor.fps_hal /vendor/bin/hw/android.hardware.biometrics.fingerprint@2.1-service
    # "class hal" causes a race condition on some devices due to files created
    # in /data. As a workaround, postpone startup until later in boot once
    # /data is mounted.
    class late_start
    user system
    group system input uhid
    task_profiles ServiceCapacityLow

on boot
    chmod 0777 /dev/goodix_fp
    chown system system /dev/goodix_fp
    chmod 0664 /dev/fpsensor
    chown system system /dev/fpsensor
    chown system system /sys/bus/platform/drivers/fpc1022_irq/soc:fpc_fp/irq
    chown system system /sys/bus/platform/drivers/fpc1022_irq/soc:fpc_fp/hw_reset
