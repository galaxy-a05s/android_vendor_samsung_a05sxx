on post-fs
    mkdir /mnt/vendor/productinfo 0771 system system
    mkdir /efs 0771 system radio
    restorecon_recursive /efs

    mkdir /efs/FactoryApp 0775 system system
    mkdir /efs/imei 0775 root radio
    mkdir /efs/wifi 0775 system system
    mkdir /efs/bluetooth 0775 system system
    mkdir /mnt/vendor/efs/DAK/ 0775 system system
    mkdir /mnt/vendor/efs/wifi 0775 system system
    mkdir /mnt/vendor/efs/bluetooth 0775 system system

    chown root system /efs/FactoryApp/control_no
    chown radio system /efs/imei/mps_code.dat
    chown system system /efs/bluetooth/bt_addr
    chown system system /efs/wifi/.mac.info
    chown system system /efs/FactoryApp/copr
    chown system system /efs/FactoryApp/plantpr
    chown system system /efs/FactoryApp/cal_date
    chown system system /efs/FactoryApp/OmitData
    chown system system /efs/imei/countryiso_code.json
    chown system system /efs/FactoryApp/cteicode
    chown system system /efs/imei/assemble
    chown system system /efs/FactoryApp/serialno
    chown system system /efs/FactoryApp/hw_ver
    chown system system /mnt/vendor/efs/DAK/
    chown root system /sys/class/power_supply/bbc/device/shipmode

    chmod 0664 /efs/bluetooth/bt_addr
    chmod 0664 /efs/wifi/.mac.info
    chmod 0666 /mnt/vendor/efs/wifi/.mac.info
    chmod 0664 /efs/imei/mps_code.dat
    chmod 0664 /efs/FactoryApp/copr
    chmod 0664 /efs/FactoryApp/plantpr
    chmod 0664 /efs/FactoryApp/cal_date
    chmod 0664 /efs/FactoryApp/control_no
    chmod 0664 /efs/FactoryApp/OmitData
    chmod 0664 /efs/imei/countryiso_code.json
    chmod 0664 /efs/FactoryApp/cteicode
    chmod 0664 /efs/imei/assemble
    chmod 0664 /efs/FactoryApp/serialno
    chmod 0664 /efs/FactoryApp/hw_ver
    chmod 0664 /mnt/vendor/efs/DAK/gakkeybox

    chmod 0220 /sys/class/power_supply/bbc/device/shipmode

#enable sar1
on property:sys.sar1.enable=1
    write /sys/bus/i2c/drivers/SX933x/1-0028/enable 0xC

#disable sar1
on property:sys.sar1.enable=0
    write /sys/bus/i2c/drivers/SX933x/1-0028/enable 0x0

#enable sar2
on property:sys.sar2.enable=1
    write /sys/class/hx9031as/channel_en 0,1
    write /sys/class/hx9031as/channel_en 1,1

#disable sar2
on property:sys.sar2.enable=0
    write /sys/class/hx9031as/channel_en 0,0
    write /sys/class/hx9031as/channel_en 1,0

on boot
    # M269 add for saving files of TP selftest
    mkdir /data/vendor/touchpad
    chown system system /data/vendor/touchpad
    chmod 0775 /data/vendor/touchpad
    setprop ro.vendor.wifi.sap.interface swlan0

on post-fs-data
    # create camera dir used by dualcamera calibration add by william.cai@bst.ai
    mkdir /mnt/vendor/persist/camera 0770 camera camera

	#Create folder of camera
    mkdir /data/vendor/camera 0777 system system
    write /data/vendor/camera/Capture3AData.dat 0
    chown system system /data/vendor/camera/Capture3AData.dat
    chmod 0777 /data/vendor/camera/Capture3AData.dat

on property:sys.boot_completed=1
    chmod 0666 /sys/class/leds/vibrator/brightness
    chown system system /sys/class/leds/vibrator/brightness
    chown system system /sys/class/leds/vibrator/trigger
    chown system system /sys/class/leds/vibrator/activate
    chown system system /sys/class/leds/vibrator/brightness
    chown system system /sys/class/leds/vibrator/duration
    chown system system /sys/class/leds/vibrator/state
    chmod 0666 /sys/class/leds/vibrator/state
    chmod 0666 /sys/class/leds/vibrator/duration
    chmod 0666 /sys/class/leds/vibrator/activate
    chown root system /sys/devices/platform/soc/4ac0000.qcom,qupv3_0_geni_se/4a88000.i2c/i2c-1/1-0028/register_write
    chown root system /sys/devices/platform/soc/4ac0000.qcom,qupv3_0_geni_se/4a88000.i2c/i2c-1/1-0028/register_read
    chmod 0660 /sys/devices/platform/soc/4ac0000.qcom,qupv3_0_geni_se/4a88000.i2c/i2c-1/1-0028/register_write
    chmod 0660 /sys/devices/platform/soc/4ac0000.qcom,qupv3_0_geni_se/4a88000.i2c/i2c-1/1-0028/register_read
    chown root system /sys/devices/platform/soc/4ac0000.qcom,qupv3_0_geni_se/4a88000.i2c/i2c-1/1-0028/enable
    chown root system /sys/devices/platform/soc/4ac0000.qcom,qupv3_0_geni_se/4a88000.i2c/i2c-1/1-0028/wifi_status
    chown root system /sys/devices/platform/soc/4ac0000.qcom,qupv3_0_geni_se/4a88000.i2c/i2c-1/1-0028/main_status
    chown root system /sys/devices/platform/soc/4ac0000.qcom,qupv3_0_geni_se/4a88000.i2c/i2c-1/1-0028/raw_data
    chown root system /sys/devices/platform/soc/4ac0000.qcom,qupv3_0_geni_se/4a88000.i2c/i2c-1/1-0028/anfr_status
    chown root system /sys/class/hx9031as/calibrate
    chown root system /sys/class/hx9031as/channel_en
    chown root system /sys/class/hx9031as/wifi_status
    chown root system /sys/class/hx9031as/main_status
    chown root system /sys/class/hx9031as/raw_data
    chown root system /sys/class/hx9031as/anfr_status
    chown root system /sys/class/hx9031as/lp_diff
    chmod 0660 /sys/devices/platform/soc/4ac0000.qcom,qupv3_0_geni_se/4a88000.i2c/i2c-1/1-0028/enable
    chmod 0660 /sys/devices/platform/soc/4ac0000.qcom,qupv3_0_geni_se/4a88000.i2c/i2c-1/1-0028/wifi_status
    chmod 0660 /sys/devices/platform/soc/4ac0000.qcom,qupv3_0_geni_se/4a88000.i2c/i2c-1/1-0028/main_status
    chmod 0660 /sys/devices/platform/soc/4ac0000.qcom,qupv3_0_geni_se/4a88000.i2c/i2c-1/1-0028/raw_data
    chmod 0660 /sys/devices/platform/soc/4ac0000.qcom,qupv3_0_geni_se/4a88000.i2c/i2c-1/1-0028/anfr_status
    chmod 0660 /sys/class/hx9031as/calibrate
    chmod 0660 /sys/class/hx9031as/channel_en
    chmod 0660 /sys/class/hx9031as/wifi_status
    chmod 0660 /sys/class/hx9031as/main_status
    chmod 0660 /sys/class/hx9031as/raw_data
    chmod 0660 /sys/class/hx9031as/anfr_status
    chmod 0660 /sys/class/hx9031as/lp_diff
    chmod 0777 /sys/class/camera/flash/rear_flash
    chown system system /sys/class/camera/flash/rear_flash
    chown system system /sys/class/power_supply/battery/lcd
    chown root root /sys/class/fingerprint/fingerprint/adm
    chmod 0777 /sys/class/fingerprint/fingerprint/adm
    chown system system /sys/class/sec/switch/afc_disable
    chown system system /sys/class/power_supply/battery/store_mode

#zhangsen1 factory test start
service agmhostless_headphone /system/vendor/bin/agmhostless -D 100 -P 103 -C 104 -p 1024 -n 4 -inputc 1 -outputc 2 -r 48000 T 200 -i 0 -o 0 -pkv 0xA2000002
    user root
    group root audio
    disabled
    oneshot

service agmhostless_spk /system/vendor/bin/agmhostless -D 100 -P 103 -C 104 -p 1024 -n 4 -inputc 1 -outputc 1 -r 48000 T 200 -i 0 -o 1 -pkv 0xA2000001
    user root
    group root audio
    disabled
    oneshot
	
service agmhostless_rec /system/vendor/bin/agmhostless -D 100 -P 103 -C 104 -p 1024 -n 4 -inputc 1 -outputc 1 -r 48000 T 200 -i 0 -o 0 -pkv 0xA2000001
    user root
    group root audio
    disabled
    oneshot
	
