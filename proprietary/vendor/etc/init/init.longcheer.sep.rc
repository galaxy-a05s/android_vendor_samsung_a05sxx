service loopback_spk_start /vendor/bin/loopback.sh 1 1
    user root
    group root audio
    disabled
    oneshot
service loopback_spk_stop /vendor/bin/loopback.sh 1 0
    user root
    group root audio
    disabled
    oneshot
on property:odm.loopback-spk=1
    start loopback_spk_start
on property:odm.loopback-spk=0
    start loopback_spk_stop

#zhangsen1 factory test end

on property:sys.chown.imei.dir=allow_system
    chown system radio /efs/imei

on property:sys.chown.imei.dir=default
    chown root radio /efs/imei

on property:sys.chmod.wifi_mac.file=allow_system
    chown system wifi /mnt/vendor/efs/wifi
    chown system wifi /mnt/vendor/efs/wifi/.mac.info
    chmod 0775 /mnt/vendor/efs/wifi/
    chmod 0664 /mnt/vendor/efs/wifi/.mac.info

on property:sys.chmod.wifi_mac.file=default
    chown wifi wifi /mnt/vendor/efs/wifi
    chown wifi wifi /mnt/vendor/efs/wifi/.mac.info
    chmod 0755 /mnt/vendor/efs/wifi/
    chmod 0644 /mnt/vendor/efs/wifi/.mac.info

#lc_sar_service
on property:sys.lc.rf.sar_id=*
    start lc_sar_service

service lc_sar_service /vendor/bin/sh /vendor/bin/libsar.sh ${sys.lc.rf.sar_id}
    user system
    group system
    oneshot
    seclabel u:r:vnd_libsar_service:s0
